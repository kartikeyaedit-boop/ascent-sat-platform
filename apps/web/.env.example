# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# Postgres connection strings (Supabase). DATABASE_URL is the pooled connection
# used at runtime; DIRECT_URL is the unpooled connection Prisma needs for migrations.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Base URL the app is served from (used to build verification/reset links in emails).
APP_URL="http://localhost:3000"

# Secret used to sign short-lived JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"

# Email (verification, password reset). Leave both unset in development:
# the mailer falls back to logging emails to the console.
#
# Preferred: Resend's HTTP API (works on serverless platforms like Vercel,
# where outbound SMTP ports are blocked). Get a key at resend.com.
RESEND_API_KEY=""
#
# Fallback: generic SMTP (only works for non-serverless deployments, e.g.
# running locally or on a traditional server). Ignored if RESEND_API_KEY is set.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SAT Platform <noreply@satplatform.dev>"

# Set by Next.js automatically in most environments; included for clarity.
NODE_ENV="development"
