// Prisma schema for Speechly, an AI public speaking coach.
// Identity/auth models below are generic and unchanged from the project's
// earlier form. Speech-domain models are added in prisma/schema.prisma as
// each phase needs them (see docs/database-schema.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  name          String
  avatarUrl     String?
  role          Role     @default(STUDENT)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  speechSessions          SpeechSession[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Every score below is computed server-side by src/lib/speech-metrics.ts
// from the submitted transcript + word timestamps — never trusted directly
// from the client, even though the client computes the same numbers live
// for in-progress display during recording. See docs/architecture.md.
model SpeechSession {
  id                String   @id @default(cuid())
  userId            String
  mode              String
  promptText        String?
  transcript        String
  durationSeconds   Int
  wpm               Float
  fillerWords       Json // [{ word, timestampMs }]
  pauseCount        Int
  longPauseCount    Int
  avgPauseMs        Float
  confidenceScore   Int
  confidenceExplanation Json // string[] — why the confidence score is what it is
  clarityScore      Int
  paceScore         Int
  vocalVarietyScore Int
  overallScore      Int
  createdAt         DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback CoachingFeedback?

  @@index([userId])
  @@map("speech_sessions")
}

model CoachingFeedback {
  id               String   @id @default(cuid())
  sessionId        String   @unique
  strengths        Json // string[]
  weaknesses       Json // string[]
  actionPlan       Json // string[]
  practiceDrills   Json // string[]
  motivationalNote String
  createdAt        DateTime @default(now())

  session SpeechSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("coaching_feedback")
}
