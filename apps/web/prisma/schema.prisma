// Prisma schema for Speechly, an AI public speaking coach.
// Identity/auth models below are generic and unchanged from the project's
// earlier form. Speech-domain models are added in prisma/schema.prisma as
// each phase needs them (see docs/database-schema.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ShopItemCategory {
  TITLE
  PET
}

enum ShopItemRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  name             String
  avatarUrl        String?
  role             Role      @default(STUDENT)
  emailVerified    Boolean   @default(false)
  xp               Int       @default(0)
  coins            Int       @default(0)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastPracticeDate DateTime?
  equippedTitleId  String?
  equippedPetId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  speechSessions          SpeechSession[]
  xpLogs                  XPLog[]
  achievements            UserAchievement[]
  purchases               Purchase[]
  equippedTitle           ShopItem?                @relation("EquippedTitle", fields: [equippedTitleId], references: [id])
  equippedPet             ShopItem?                @relation("EquippedPet", fields: [equippedPetId], references: [id])

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Every score below is computed server-side by src/lib/speech-metrics.ts
// from the submitted transcript + word timestamps — never trusted directly
// from the client, even though the client computes the same numbers live
// for in-progress display during recording. See docs/architecture.md.
model SpeechSession {
  id                    String   @id @default(cuid())
  userId                String
  mode                  String
  promptText            String?
  transcript            String
  durationSeconds       Int
  wpm                   Float
  fillerWords           Json // [{ word, timestampMs }]
  pauseCount            Int
  longPauseCount        Int
  avgPauseMs            Float
  confidenceScore       Int
  confidenceExplanation Json // string[] — why the confidence score is what it is
  clarityScore          Int
  paceScore             Int
  vocalVarietyScore     Int
  overallScore          Int
  createdAt             DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback CoachingFeedback?

  @@index([userId])
  @@map("speech_sessions")
}

model CoachingFeedback {
  id               String   @id @default(cuid())
  sessionId        String   @unique
  summary          String   @default("") // short paragraph tying together overall level, top strength/weakness, and the top improvement action
  strengths        Json // string[]
  weaknesses       Json // string[]
  actionPlan       Json // string[]
  practiceDrills   Json // string[]
  motivationalNote String
  createdAt        DateTime @default(now())

  session SpeechSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("coaching_feedback")
}

// Audit trail of every XP award — lets the level/streak math stay derived and
// auditable rather than trusting a single mutable counter. See src/lib/gamification.ts.
model XPLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // e.g. "session_complete", "streak_bonus", "achievement:first_session"
  sessionId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("xp_logs")
}

// Static achievement definitions. Checked by src/server/gamification/achievements.ts,
// not a generic rules engine — each achievement has hand-written unlock logic.
model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique // stable code identifier, e.g. "first_session"
  name        String
  description String
  icon        String // lucide icon name
  xpReward    Int      @default(0)
  coinReward  Int      @default(0)
  createdAt   DateTime @default(now())

  unlockedBy UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// A small, real cosmetic shop: profile title badges and collectible pets,
// purchasable with coins earned from practicing. Titles and pets are
// equipped independently (a user can have one of each on at once), hence
// the two separate named relations back from User.
model ShopItem {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String // the title text or pet name, e.g. "Wordsmith" or "Fox"
  category  ShopItemCategory @default(TITLE)
  emoji     String           @default("🏷️")
  rarity    ShopItemRarity   @default(COMMON)
  price     Int
  createdAt DateTime         @default(now())

  purchases         Purchase[]
  equippedAsTitleBy User[]     @relation("EquippedTitle")
  equippedAsPetBy   User[]     @relation("EquippedPet")

  @@map("shop_items")
}

model Purchase {
  id         String   @id @default(cuid())
  userId     String
  shopItemId String
  pricePaid  Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@unique([userId, shopItemId])
  @@index([userId])
  @@map("purchases")
}
